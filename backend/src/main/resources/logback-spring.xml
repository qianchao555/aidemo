<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <contextName>xiaofuziService</contextName>



    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>debug</level>
        </filter>
        <encoder>
            <pattern>[%d{yyyy-MM-dd HH:mm:ss.SSS}] [%level] [%contextName] [%logger{80}:%L] %msg%n</pattern>
        </encoder>
    </appender>

    <root>
        <appender-ref ref="console" level="debug"/>
    </root>

    <logger name="org.springframework" level="info"/>
    <logger name="org.hibernate" level="info"/>
    <logger name="org.apache.ibatis.session.defaults" level="info"/>
    <logger name="com.netflix" level="info"/>
    <logger name="org.apache.http" level="info"/>
    <logger name="org.apache.hc.client5" level="error"/>
    <logger name="com.netflix.loadbalancer" level="info"/>
    <logger name="org.apache.activemq.ActiveMQSession" level="error"/>
    <logger name="org.mybatis" level="DEBUG"/>
    <logger name="org.springframework.boot" level="info"/>
    <logger name="org.redisson" level="error"/>
    <logger name="com.alibaba.cloud.ai" level="info"/>
    <logger name="org.springframework.ai" level="info"/>
    <logger name="com.xiaofuzi.ai" level="debug"/>

</configuration>
